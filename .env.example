# Copy to .env and fill in. There is no API key: the app signs in to Microsoft Foundry with
# Microsoft Entra ID (`az login` locally, the container app's managed identity on Azure).

# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of the model deployment in that project
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# Optional
# ITG_OFFLINE=1               # run without Foundry: agents fall back to deterministic templates
# ITG_MAX_LIVE_SESSIONS=3     # live watch rooms allowed at once (cost guard on a public URL)
# ITG_FORECAST_RUNS=120       # simulator replays per minute for the live win probability
# ITG_DATA_DIR=data           # where matches and recorded agent runs are stored
